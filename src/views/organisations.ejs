<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">WORKING TOGETHER</p>
            <h1>
                <%= title %>
            </h1>
            <p>Meet some of the organisations making a difference through service.</p>
        </section>

        <section class="organization-grid" aria-label="Partner organisations">
            <article class="organization-card">
                <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">
                <div>
                    <h2>BrightFuture Builders</h2>
                    <p>Supporting opportunities that help people learn, grow, and build a brighter future.</p>
                    <a href="mailto:info@brightfuture.org">info@brightfuture.org</a>
                </div>
            </article>

            <article class="organization-card">
                <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">
                <div>
                    <h2>GreenHarvest Growers</h2>
                    <p>Encouraging environmental care and sustainable community practices.</p>
                    <a href="mailto:contact@greenharvest.org">contact@greenharvest.org</a>
                </div>
            </article>

            <article class="organization-card">
                <img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo">
                <div>
                    <h2>UnityServe Volunteers</h2>
                    <p>Bringing people together to support local needs through volunteering.</p>
                    <a href="mailto:hello@unityserve.org">hello@unityserve.org</a>
                </div>
            </article>
        </section>
    </main>

    <%- include('partials/footer') %>